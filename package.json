{
  "name": "maliu",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.10.x"
  },
  "scripts": {
    "emulator": "node scripts/dev.mjs emulator",
    "start": "node scripts/dev.mjs start",
    "android": "node scripts/dev.mjs build",
    "android:release": "node scripts/dev.mjs build --variant release",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "expo": "58.0.19",
    "expo-dev-client": "58.0.15",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.14",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
